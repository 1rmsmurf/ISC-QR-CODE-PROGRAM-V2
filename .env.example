# BOX API Configuration
# Get your developer token from: https://app.box.com/developers/console
BOX_DEVELOPER_TOKEN=Ommitted for security reasons

# For production, use OAuth instead of developer token
# BOX_CLIENT_ID=your_client_id
# BOX_CLIENT_SECRET=your_client_secret

# Optional: Specific folder IDs for each category
# BOX_FOLDER_TEAM_PHOTOS=0
# BOX_FOLDER_CAR_SHOTS=0
# BOX_FOLDER_BTS=0

# Base URL for QR codes
# Update this to your Vercel URL after deployment
NEXT_PUBLIC_BASE_URL=https://isc-qr-code-program-v2.vercel.app/
